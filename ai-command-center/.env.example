# Copy to .env (dev) or .env.prod (prod) and fill in. NEVER commit the real file.
# APP_ENV: dev | test | prod  (dev/test never send real Telegram messages unless TELEGRAM_DRY_RUN=false)
APP_ENV=dev
TIMEZONE=Asia/Seoul

# Telegram - use a SEPARATE test bot for dev and the real bot for prod
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to command the bot (find yours: python -m app telegram-whoami)
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_DRY_RUN=true

# Dashboard/API (required in prod). Long random string.
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000

# AI safety switches (AI providers are connected in ROADMAP step 5)
LLM_ENABLED=false
LLM_DAILY_CALL_LIMIT=50
LLM_MONTHLY_BUDGET_KRW=0
