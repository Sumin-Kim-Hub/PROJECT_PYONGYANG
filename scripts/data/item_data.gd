static func item_name(id: String) -> String:
	if ITEMS.has(id):
		return str(ITEMS[id].get("name", id))
	return id


static func item_desc(id: String) -> String:
	if ITEMS.has(id):
		return str(ITEMS[id].get("desc", ""))
	return ""
